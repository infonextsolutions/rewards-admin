# Copy to .env.production and fill in. Used as build args by docker-compose.prod.yml.
# NEXT_PUBLIC_* values are baked into the image at build time: rebuild after changing them.

# Backend API base URL for production (include /api)
NEXT_PUBLIC_API_BASE=https://api.indoviaholdings.com/api

# Sentry DSN (leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=production

# Host port the admin panel is published on
ADMIN_PORT=3000
