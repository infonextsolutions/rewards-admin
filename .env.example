# Copy to .env.local and fill in. Do not commit real values.

# Backend API base URL (include /api). Replace with your target environment.
NEXT_PUBLIC_API_BASE=https://api.example.com/api

# Error Tracking (Sentry)
# DSN from sentry.io project settings (jackson-admin); leave empty to disable
NEXT_PUBLIC_SENTRY_DSN=
# uat | production; if unset, inferred from NEXT_PUBLIC_API_BASE
NEXT_PUBLIC_SENTRY_ENV=
