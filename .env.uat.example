# Copy to .env.uat and fill in. Used as build args by docker-compose.uat.yml.
# NEXT_PUBLIC_* values are baked into the image at build time: rebuild after changing them.

# Backend API base URL for UAT (include /api)
NEXT_PUBLIC_API_BASE=https://api.uat.indoviaholdings.com/api

# Sentry DSN (leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=uat

# Host port the admin panel is published on
ADMIN_PORT=3001
