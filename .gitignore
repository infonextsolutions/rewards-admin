# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local hidden directories; retain shared workflow and package-manager files
/.*/
!/.github/
!/.yarn/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local configuration; keep the credential-free setup template
.env*
!.env.example

# Editor temporary files
*.swp
*.swo
*~

# Local credentials and diagnostic output
*.key
*.p12
*.pfx
*.log
/playwright-report/
/test-results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
